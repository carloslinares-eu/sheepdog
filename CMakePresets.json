{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed"
      }
    },
    {
      "name": "win-base",
      "hidden": true,
      "inherits": "base",
      "description": "MinGW-w64 GCC 13.1 with Qt 6.12 (set SHEEPDOG_QT_DIR, see CMakeUserPresets.json)",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_PREFIX_PATH": "$env{SHEEPDOG_QT_DIR}",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static"
      }
    },
    {
      "name": "win-debug",
      "displayName": "Windows Debug (MinGW)",
      "inherits": "win-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "win-release",
      "displayName": "Windows Release (MinGW)",
      "inherits": "win-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "win-ci",
      "displayName": "Windows CI (MinGW, warnings as errors)",
      "inherits": "win-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_HOST_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug (GCC)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release (GCC)",
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "linux-clang",
      "hidden": true,
      "inherits": "linux-base",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux ASan + UBSan (Clang)",
      "inherits": "linux-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SHEEPDOG_SANITIZE": "address,undefined" }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux TSan (Clang)",
      "inherits": "linux-clang",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "SHEEPDOG_SANITIZE": "thread" }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux libFuzzer (Clang)",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "SHEEPDOG_SANITIZE": "address,undefined",
        "SHEEPDOG_BUILD_FUZZ": "ON",
        "SHEEPDOG_BUILD_GUI": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "win-debug", "configurePreset": "win-debug" },
    { "name": "win-release", "configurePreset": "win-release" },
    { "name": "win-ci", "configurePreset": "win-ci" },
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "linux-fuzz", "configurePreset": "linux-fuzz" }
  ],
  "testPresets": [
    { "name": "test-base", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "win-debug", "inherits": "test-base", "configurePreset": "win-debug" },
    { "name": "win-release", "inherits": "test-base", "configurePreset": "win-release" },
    { "name": "win-ci", "inherits": "test-base", "configurePreset": "win-ci" },
    { "name": "linux-debug", "inherits": "test-base", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "test-base", "configurePreset": "linux-release" },
    { "name": "linux-asan", "inherits": "test-base", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "inherits": "test-base", "configurePreset": "linux-tsan" }
  ]
}
