# Script mode: cmake -DSOURCE_DIR=... -DOUTPUT=... -DPROJECT_VERSION=... -P GitVersion.cmake
#
# Version rules (docs/DESIGN.md, "CI and packaging"):
#   - release tag sheepdog-X.Y.Z on HEAD, clean tree  -> X.Y.Z
#   - otherwise                                     -> X.Y.Z-N-gSHA[-dirty]
#     where N counts commits since the last sheepdog-* tag (or since the first
#     commit when there is no tag yet). X.Y.Z always comes from project(VERSION).
#   - no git available                              -> X.Y.Z
set(full "${PROJECT_VERSION}")
set(commit "")

find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git")
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE rc
        OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(rc EQUAL 0)
        execute_process(COMMAND "${GIT_EXECUTABLE}" describe --match "sheepdog-*" --long --abbrev=7
            WORKING_DIRECTORY "${SOURCE_DIR}" RESULT_VARIABLE rc
            OUTPUT_VARIABLE described OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(rc EQUAL 0 AND described MATCHES "-([0-9]+)-g[0-9a-f]+$")
            set(distance "${CMAKE_MATCH_1}")
        else()
            execute_process(COMMAND "${GIT_EXECUTABLE}" rev-list --count HEAD
                WORKING_DIRECTORY "${SOURCE_DIR}"
                OUTPUT_VARIABLE distance OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        endif()
        execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no
            WORKING_DIRECTORY "${SOURCE_DIR}"
            OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        set(dirty "")
        if(NOT changes STREQUAL "")
            set(dirty "-dirty")
        endif()
        if(NOT (distance STREQUAL "0" AND dirty STREQUAL ""))
            set(full "${PROJECT_VERSION}-${distance}-g${commit}${dirty}")
        endif()
    else()
        set(commit "")
    endif()
endif()

set(content "// Generated by cmake/GitVersion.cmake. Do not edit.
#include \"core/version.hpp\"

namespace sheepdog {

std::string_view project_version() noexcept { return \"${PROJECT_VERSION}\"; }
std::string_view version() noexcept { return \"${full}\"; }
std::string_view git_commit() noexcept { return \"${commit}\"; }

} // namespace sheepdog
")

# Rewrite only on change, so an unchanged version does not relink anything.
set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
